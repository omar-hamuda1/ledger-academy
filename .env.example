# Postgres connection strings (Neon). Pulled automatically into .env by
# `neon link` / `neon config init` — see prisma/schema.prisma's datasource.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"
NEON_BRANCH="main"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional — only needed to actually send OTP verification emails. Without
# these, sendOtpEmail() logs the code to the server console instead, so
# signup/forgot password flows stay testable without an email account.
# Brevo free tier: 300 emails/day, no credit card. Create an API key under
# SMTP & API → API Keys, and verify EMAIL_FROM as a sender first.
BREVO_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="Ledger Academy"

# Optional — only needed for rate limiting to work correctly on serverless
# deployments (e.g. Vercel) or across multiple instances. Without these,
# checkRateLimit() falls back to an in-memory counter that only works
# correctly on a single long-running process. Free tier at upstash.com,
# no credit card required.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Neon Object Storage (S3-compatible) — holds student payment-proof
# screenshots. AWS-standard names so the S3 SDK picks them up automatically.
# Populated by `neon env pull` after `neon deploy` provisions the bucket
# declared in neon.ts. Without them, payment-proof upload returns a clear
# "not configured" error and the request form is unusable.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
