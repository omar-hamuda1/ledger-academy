# Postgres connection strings (Neon). Pulled automatically into .env by
# `neon link` / `neon config init` — see prisma/schema.prisma's datasource.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"
NEON_BRANCH="main"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional — only needed to actually send OTP verification emails. Without
# these, sendOtpEmail() logs the code to the server console instead, so
# signup/forgot password flows stay testable without a SendGrid account.
SENDGRID_API_KEY=""
EMAIL_FROM=""

# Optional — only needed for rate limiting to work correctly on serverless
# deployments (e.g. Vercel) or across multiple instances. Without these,
# checkRateLimit() falls back to an in-memory counter that only works
# correctly on a single long-running process. Free tier at upstash.com,
# no credit card required.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
