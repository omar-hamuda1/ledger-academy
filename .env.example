# Postgres connection strings (Neon). Pulled automatically into .env by
# `neon link` / `neon config init` — see prisma/schema.prisma's datasource.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"
NEON_BRANCH="main"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional — only needed for paid courses. Without these, checkout on any
# course priced above 0 returns a clear "payments not enabled" error instead
# of crashing; free courses (price 0) work regardless.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional — only needed to actually send OTP verification emails. Without
# these, sendOtpEmail() logs the code to the server console instead, so
# signup/forgot password flows stay testable without a SendGrid account.
SENDGRID_API_KEY=""
EMAIL_FROM=""
