generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         Role     @default(STUDENT)
  avatarUrl    String?
  createdAt    DateTime @default(now())

  enrollments           Enrollment[]
  progress              LessonProgress[]
  quizAttempts          QuizAttempt[]
  coursesOwned          Course[]           @relation("InstructorCourses")
  redeemedCodes         PrepaidCode[]
  codeOrders            CodeOrder[]        @relation("RequestedCodeOrders")
  reviewedCodeOrders    CodeOrder[]        @relation("ReviewedCodeOrders")
  notificationsTargeted Notification[]     @relation("NotificationTarget")
  notificationsAuthored Notification[]     @relation("NotificationAuthor")
  notificationReads     NotificationRead[]
}

enum Role {
  ADMIN
  STUDENT
}

model Course {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  grade        String?
  thumbnailUrl String?
  price        Decimal  @default(0)
  isPublished  Boolean  @default(false)
  instructorId String
  instructor   User     @relation("InstructorCourses", fields: [instructorId], references: [id])
  createdAt    DateTime @default(now())

  modules      Module[]
  enrollments  Enrollment[]
  prepaidCodes PrepaidCode[]
  codeOrders   CodeOrder[]
}

model Module {
  id       String @id @default(cuid())
  title    String
  order    Int
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]
}

model Lesson {
  id       String @id @default(cuid())
  title    String
  order    Int
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  videoUrl    String?
  contentHtml String?
  durationSec Int?

  resources Resource[]
  progress  LessonProgress[]
  quiz      Quiz?
}

model Resource {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  label    String
  fileUrl  String
  fileType String
}

model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  courseId   String
  user       User             @relation(fields: [userId], references: [id])
  course     Course           @relation(fields: [courseId], references: [id])
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(ACTIVE)

  @@unique([userId, courseId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// A single-use prepaid access code for one course. The lecturer generates
// batches of these and sells/hands them out offline; a student redeems one to
// get a real Enrollment without going through Stripe. Redemption is the
// second (and only other) sanctioned enrollment-granting path besides
// /api/checkout — see CLAUDE.md.
model PrepaidCode {
  id        String     @id @default(cuid())
  code      String     @unique
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isUsed    Boolean    @default(false)
  usedById  String?
  usedBy    User?      @relation(fields: [usedById], references: [id])
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  codeOrder CodeOrder?

  @@index([courseId])
  @@index([courseId, isUsed])
}

// A student's request to buy access to a paid course. Money is transferred
// manually (Vodafone Cash / InstaPay / bank / cash) off-platform; the student
// records how in `paymentNote`, the lecturer verifies it and approves.
// Approving issues a used PrepaidCode for that student + creates the
// Enrollment in one transaction (see /api/code-orders/[id]). This is the
// second sanctioned enrollment path — see CLAUDE.md.
model CodeOrder {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation("RequestedCodeOrders", fields: [userId], references: [id])
  courseId        String
  course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status          CodeOrderStatus @default(PENDING)
  studentPhone    String
  paymentNote     String
  paymentProofKey String?
  reviewedById    String?
  reviewedBy      User?           @relation("ReviewedCodeOrders", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  prepaidCodeId   String?         @unique
  prepaidCode     PrepaidCode?    @relation(fields: [prepaidCodeId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([userId])
  @@index([courseId, status])
}

enum CodeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

// In-app notification shown in the dashboard header bell.
//  - `targetUserId` set  -> delivered to that one user (system events:
//    CodeOrder approve/reject to the student, new request to admins).
//  - `targetUserId` null -> broadcast, visible to every STUDENT (admin
//    composes these at /dashboard/admin/notifications).
// Read state lives in NotificationRead (a row per user who has seen it), so a
// broadcast is one row regardless of student count.
model Notification {
  id           String             @id @default(cuid())
  title        String
  body         String
  href         String?
  targetUserId String?
  targetUser   User?              @relation("NotificationTarget", fields: [targetUserId], references: [id])
  createdById  String?
  createdBy    User?              @relation("NotificationAuthor", fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  reads        NotificationRead[]

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}

model OtpCode {
  id         String     @id @default(cuid())
  email      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
}

enum OtpPurpose {
  SIGNUP
  RESET
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model SiteSettings {
  id                  String  @id @default("main")
  studentsCount       Int     @default(5000)
  satisfactionRate    Int     @default(98)
  contactEmail        String  @default("info@ledgeracademy.com")
  contactPhone        String  @default("+20000000000")
  showBreakEvenTool   Boolean @default(true)
  showSwotTool        Boolean @default(true)
  announcement        String?
  announcementActive  Boolean @default(false)
  paymentInstructions String?
}

model LessonProgress {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String
  user       User     @relation(fields: [userId], references: [id])
  lesson     Lesson   @relation(fields: [lessonId], references: [id])
  completed  Boolean  @default(false)
  watchedSec Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Quiz {
  id        String        @id @default(cuid())
  lessonId  String        @unique
  lesson    Lesson        @relation(fields: [lessonId], references: [id])
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id        String @id @default(cuid())
  quizId    String
  quiz      Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text      String
  options   Json
  correctId String
}

model QuizAttempt {
  id      String   @id @default(cuid())
  userId  String
  quizId  String
  user    User     @relation(fields: [userId], references: [id])
  quiz    Quiz     @relation(fields: [quizId], references: [id])
  score   Float
  takenAt DateTime @default(now())
}
