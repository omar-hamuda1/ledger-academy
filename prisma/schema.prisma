generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App runtime uses the pooled URL. Prisma Migrate (migrate deploy/dev, db
  // push) uses directUrl — the non-pooler Neon endpoint — because acquiring a
  // session-level `pg_advisory_lock` over the transaction pooler times out
  // (P1002). See https://pris.ly/d/migrate-advisory-locking.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         Role      @default(STUDENT)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  disabledAt   DateTime? // set by an admin -> login is refused
  superAdmin   Boolean   @default(false) // protected: only another super-admin (or direct DB/CLI) can change this account's role/status/password. Granted only via `npm run admin:super`, never through the API/UI.
  restrictedScopes String[] @default([]) // ADMIN deny-list: dashboard sections this admin is blocked from (keys in src/lib/authz.ts). Empty = full access. Super-admins ignore it. Written only by the super-admin-only `setPermissions` action on PATCH /api/users/[id].

  // Parental/guardian consent captured at signup (students are minors). Set once
  // by POST /api/register; a required checkbox on the signup form. Null on
  // accounts created before this was added (2026-09-09) and on admin-script
  // accounts. Guardian name/contact are optional free text.
  guardianConsentAt DateTime?
  guardianName      String?
  guardianContact   String?

  enrollments           Enrollment[]
  progress              LessonProgress[]
  quizAttempts          QuizAttempt[]
  certificates          Certificate[]
  reviews               Review[]
  lessonQuestions       LessonQuestion[]
  lessonAnswers         LessonAnswer[]
  coursesOwned          Course[]           @relation("InstructorCourses")
  redeemedCodes         PrepaidCode[]
  codeOrders            CodeOrder[]        @relation("RequestedCodeOrders")
  reviewedCodeOrders    CodeOrder[]        @relation("ReviewedCodeOrders")
  notificationsTargeted Notification[]     @relation("NotificationTarget")
  notificationsAuthored Notification[]     @relation("NotificationAuthor")
  notificationReads     NotificationRead[]
}

enum Role {
  ADMIN
  STUDENT
}

model Course {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  grade        String?
  thumbnailUrl String?
  price        Decimal  @default(0)
  isPublished  Boolean  @default(false)
  instructorId String
  instructor   User     @relation("InstructorCourses", fields: [instructorId], references: [id])
  createdAt    DateTime @default(now())

  modules      Module[]
  enrollments  Enrollment[]
  prepaidCodes PrepaidCode[]
  codeOrders   CodeOrder[]
  certificates Certificate[]
  reviews      Review[]
}

// A student's rating (+ optional text) for a course they're enrolled in.
// One per (user, course) — POST upserts. `hidden` lets an admin suppress an
// abusive review without deleting it; hidden reviews are excluded from the
// average and the public list.
model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  body      String?
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

// Issued once a student completes 100% of a course's lessons. `serial` is the
// public, shareable id — /certificates/<serial> renders and verifies it.
model Certificate {
  id       String   @id @default(cuid())
  serial   String   @unique
  userId   String
  courseId String
  user     User     @relation(fields: [userId], references: [id])
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

model Module {
  id       String @id @default(cuid())
  title    String
  order    Int
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]
}

model Lesson {
  id       String @id @default(cuid())
  title    String
  order    Int
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  videoUrl    String?
  contentHtml String?
  durationSec Int?

  resources Resource[]
  progress  LessonProgress[]
  quiz      Quiz?
  questions LessonQuestion[]
}

// Student Q&A tied to a lesson. A question has zero or more answers; an answer
// from an ADMIN is flagged `byInstructor` for the UI. Both cascade from the
// lesson, so deleting a lesson takes its Q&A with it.
model LessonQuestion {
  id        String         @id @default(cuid())
  lessonId  String
  userId    String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  answers   LessonAnswer[]

  @@index([lessonId])
  @@index([userId])
}

model LessonAnswer {
  id           String         @id @default(cuid())
  questionId   String
  userId       String
  question     LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id])
  body         String
  byInstructor Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([questionId])
  @@index([userId])
}

model Resource {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  label    String
  fileUrl  String
  fileType String
}

model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  courseId   String
  user       User             @relation(fields: [userId], references: [id])
  course     Course           @relation(fields: [courseId], references: [id])
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(ACTIVE)

  @@unique([userId, courseId])
  // where:{userId} is served by the unique index's leading column; this covers
  // the course-scoped reads (admin "enrollments per course", metrics).
  @@index([courseId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// A single-use prepaid access code for one course. The lecturer generates
// batches of these and sells/hands them out offline; a student redeems one to
// get a real Enrollment without going through Stripe. Redemption is the
// second (and only other) sanctioned enrollment-granting path besides
// /api/checkout — see CLAUDE.md.
model PrepaidCode {
  id        String     @id @default(cuid())
  code      String     @unique
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isUsed    Boolean    @default(false)
  usedById  String?
  usedBy    User?      @relation(fields: [usedById], references: [id])
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  codeOrder CodeOrder?

  @@index([courseId])
  @@index([courseId, isUsed])
}

// A student's request to buy access to a paid course. Money is transferred
// manually (Vodafone Cash / InstaPay / bank / cash) off-platform; the student
// records how in `paymentNote`, the lecturer verifies it and approves.
// Approving issues a used PrepaidCode for that student + creates the
// Enrollment in one transaction (see /api/code-orders/[id]). This is the
// second sanctioned enrollment path — see CLAUDE.md.
model CodeOrder {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation("RequestedCodeOrders", fields: [userId], references: [id])
  courseId        String
  course          Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status          CodeOrderStatus @default(PENDING)
  studentPhone    String
  // InstaPay transaction reference (المرجع). One transfer can back only one
  // order — the unique index is the anti-reuse guard. Nullable so orders
  // created before this field stay valid.
  paymentReference String?        @unique
  paymentNote     String?
  paymentProofKey String?
  reviewedById    String?
  reviewedBy      User?           @relation("ReviewedCodeOrders", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  prepaidCodeId   String?         @unique
  prepaidCode     PrepaidCode?    @relation(fields: [prepaidCodeId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([userId])
  @@index([courseId, status])
}

enum CodeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

// In-app notification shown in the dashboard header bell.
//  - `targetUserId` set  -> delivered to that one user (system events:
//    CodeOrder approve/reject to the student, new request to admins).
//  - `targetUserId` null -> broadcast, visible to every STUDENT (admin
//    composes these at /dashboard/admin/notifications).
// Read state lives in NotificationRead (a row per user who has seen it), so a
// broadcast is one row regardless of student count.
model Notification {
  id           String               @id @default(cuid())
  title        String
  body         String
  href         String?
  targetUserId String?
  targetUser   User?                @relation("NotificationTarget", fields: [targetUserId], references: [id])
  createdById  String?
  createdBy    User?                @relation("NotificationAuthor", fields: [createdById], references: [id])
  createdAt    DateTime             @default(now())
  // Only meaningful for broadcasts (targetUserId null). CURRENT_STUDENTS: seen
  // only by students who existed when it was sent (createdAt >= user.createdAt).
  // ALL_STUDENTS: seen by every student, including later signups. Ignored for
  // targeted rows.
  audience     NotificationAudience @default(CURRENT_STUDENTS)
  reads        NotificationRead[]

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

enum NotificationAudience {
  CURRENT_STUDENTS
  ALL_STUDENTS
}

model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}

model OtpCode {
  id         String     @id @default(cuid())
  email      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
}

enum OtpPurpose {
  SIGNUP
  RESET
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model SiteSettings {
  id                  String  @id @default("main")
  studentsCount       Int     @default(5000)
  satisfactionRate    Int     @default(98)
  contactEmail        String  @default("info@ledgeracademy.com")
  contactPhone        String  @default("+20000000000")
  showBreakEvenTool   Boolean @default(true)
  showSwotTool        Boolean @default(true)
  announcement        String?
  announcementActive  Boolean @default(false)
  paymentInstructions String?
}

model LessonProgress {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String
  user       User     @relation(fields: [userId], references: [id])
  lesson     Lesson   @relation(fields: [lessonId], references: [id])
  completed  Boolean  @default(false)
  watchedSec Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, lessonId])
  // where:{userId} uses the unique index prefix; this covers lesson-scoped
  // reads and the delete-cascade cleanup in /api/lessons/[id].
  @@index([lessonId])
}

model Quiz {
  id           String        @id @default(cuid())
  lessonId     String        @unique
  lesson       Lesson        @relation(fields: [lessonId], references: [id])
  // null = untimed. When set, the student player counts down and auto-submits
  // at zero (client-side; not server-enforced).
  timeLimitSec Int?
  questions    Question[]
  attempts     QuizAttempt[]
}

model Question {
  id        String @id @default(cuid())
  quizId    String
  quiz      Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text      String
  options   Json
  correctId String

  @@index([quizId])
}

model QuizAttempt {
  id      String   @id @default(cuid())
  userId  String
  quizId  String
  user    User     @relation(fields: [userId], references: [id])
  quiz    Quiz     @relation(fields: [quizId], references: [id])
  score   Float
  takenAt DateTime @default(now())

  @@index([userId])
  @@index([quizId])
}
